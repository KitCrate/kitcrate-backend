# Soroban RPC endpoint. Testnet by default; mainnet is
# https://soroban-rpc.mainnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Deployed RentalEscrow contract id (C... address). Required to run the
# event listener and to serve agreement data (all agreement rows and
# lookups are scoped to this id); the listings API works without it.
CONTRACT_ID=

# Postgres connection string for the indexer database
DATABASE_URL=postgres://kitcrate:kitcrate@localhost:5432/kitcrate

# HTTP port for the REST API
PORT=3000

# Poll interval for the event listener, in milliseconds
POLL_INTERVAL_MS=5000

# First ledger to scan when no checkpoint exists. Set this to the ledger
# where the contract was deployed (or slightly earlier); the RPC node
# only retains recent history.
START_LEDGER=1
