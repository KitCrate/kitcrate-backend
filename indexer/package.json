{
  "name": "kitcrate-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Event indexer and REST API for the KitCrate RentalEscrow Soroban contract",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --env-file=.env.test --env-file-if-exists=.env.test.local --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
