# Environment for `npm test` (indexer/test/*.test.ts). Loaded via
# `node --env-file=.env.test`. Points at the disposable Postgres started
# by `docker-compose.test.yml` (see the Makefile's `test-db-up` target),
# never at the dev database in docker-compose.yml — tests truncate
# tables between runs and must never touch real dev data.
#
# These are the same well-known, non-secret local-only placeholder
# credentials already used in docker-compose.yml and .env.example; there
# is nothing sensitive in this file.
DATABASE_URL=postgres://kitcrate:kitcrate@localhost:5434/kitcrate_test
